# WhatsApp Cloud API credentials
WA_TOKEN=your_meta_system_user_access_token_here
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WA_RECIPIENT=6281234567890
WA_GROUP_URL=https://chat.whatsapp.com/your_group_invite_code
WA_VERIFY_TOKEN=compressor_verify_secret_token
WA_APP_SECRET=your_meta_app_secret_here
WA_API_VERSION=v22.0

# Optional custom paths (auto-detected if blank)
FFMPEG_PATH=
FFPROBE_PATH=

# App settings
DATA_DIR=./data
FILE_TTL_HOURS=2
MAX_CONCURRENT_VIDEO_JOBS=1
