---
import '../styles/global.css';
import Compressor from '../components/Compressor.svelte';
---

<html lang="id" data-theme="dark" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0f0d" />
    <title>WhatsApp Media Compressor</title>
    <meta name="description" content="Pre-encode foto & video ke spesifikasi WhatsApp, lalu kirim ke nomor sendiri tanpa kompresi ganda." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
  </head>
  <body class="min-h-dvh bg-ink-950 text-ink-100 antialiased">
    <div class="mx-auto max-w-5xl px-5 pb-24 pt-10 sm:pt-14">
      <!-- Top bar -->
      <header class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-wa-500/15 text-wa-400">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/>
            </svg>
          </div>
          <span class="font-medium text-ink-50">WhatsApp Compressor</span>
        </div>
        <span class="chip text-ink-400">untuk pemilik · Naufal</span>
      </header>

      <!-- Hero -->
      <div class="mt-12 sm:mt-16 max-w-2xl">
        <h1 class="text-3xl sm:text-4xl tracking-tighter leading-tight text-ink-50">
          Media jernih, sekali encode.
        </h1>
        <p class="mt-4 max-w-[52ch] text-ink-400 leading-relaxed">
          Kompres foto & video sesuai spesifikasi WhatsApp <em class="not-italic text-ink-200">sebelum</em> dikirim.
          Hasilnya sampai tanpa re-encode ganda yang bikin pecah.
        </p>
      </div>

      <!-- App -->
      <main class="mt-10">
        <Compressor client:load />
      </main>

      <!-- Footnote -->
      <footer class="mt-16 border-t border-ink-800 pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs text-ink-500">
        <p>File dihapus otomatis · konten tidak dilog · token hanya di server.</p>
        <p class="metric">Chat · Status · Dokumen — 5 / 16 / 100 MB</p>
      </footer>
    </div>
  </body>
</html>